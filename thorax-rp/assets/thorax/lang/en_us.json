    "item.thorax.cabbage_butterfly": "Cabbage Butterfly",
    "item.thorax.cabbage_butterfly.scientific_name": "Pieris rapae",
    "item.thorax.cabbage_butterfly.description": "A common, small, white butterfly with characteristic black spots. As larva, they feast upon leafy vegetables such as lettuce and broccoli, but switch to eating flower nectar as adults.",
    "item.thorax.agrias_butterfly": "Agrias Butterfly",
    "item.thorax.agrias_butterfly.scientific_name": "Agrias claudina",
    "item.thorax.agrias_butterfly.description": "A fast-flying butterfly that feasts upon rotting fruit and organic matter. Its striking coloration gives the impression to would-be predators that it is toxic.",
    "item.thorax.monarch_butterfly": "Monarch Butterfly",
    "item.thorax.monarch_butterfly.scientific_name": "Danaus plexippus",
    "item.thorax.monarch_butterfly.description": "A rare sight in the rest of the world but a commonality among the gilded heights of the Golden Isles. They spread their wings and soak up the sun to reinvigorate themselves.",
    "item.thorax.blazing_daggerwing": "Blazing Daggerwing",
    "item.thorax.blazing_daggerwing.scientific_name": "Marpesia ignius",
    "item.thorax.blazing_daggerwing.description": "Warm-blooded ancient butterflies unfortunate enough to end up stranded in the Nether had to make some adaptations, learning to feast upon the native fungi and seek the gentle warmth of glowstone clusters.",
    "item.thorax.arctic_apollo": "Arctic Apollo",
    "item.thorax.arctic_apollo.scientific_name": "Parnassius arcticus",
    "item.thorax.arctic_apollo.description": "In order to survive the harsh cold, these critters take infrequent hibernation-like naps in tree cavities and caverns.",
    "item.thorax.miller_moth": "Miller Moth",
    "item.thorax.miller_moth.scientific_name": "Acronicta leporina",
    "item.thorax.miller_moth.description": "A mindless insect that gets easily disoriented by light sources. As larvae, they feast upon leaves and switch to a nectar based diet as adults.",
    "item.thorax.hawk_moth": "Hawk Moth",
    "item.thorax.hawk_moth.scientific_name": "Lymantria dispar",
    "item.thorax.hawk_moth.description": "???",
